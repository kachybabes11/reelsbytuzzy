<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Reelsbytuzzy</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="stylesheet" href="/styles/layout.css" />
	</head>
	<body>
		<div class="site-bg-glow site-bg-glow-a"></div>
		<div class="site-bg-glow site-bg-glow-b"></div>

		<header class="site-header">
			<div class="top-ribbon">
				<span>Tuzzy Media Concepts</span>
			</div>
			<nav class="main-nav">
				<div class="nav-left">
					<button class="nav-toggle" type="button" aria-label="Open navigation menu" aria-controls="site-nav-links" aria-expanded="false">
						<span></span>
						<span></span>
						<span></span>
					</button>
					<a class="brand" href="/">
						<div class="brand-mark">
							<img src="/assets/brand_logo.PNG" alt="Reelsbytuzzy" />
						</div>
						
					</a>
				</div>

				<div class="nav-links" id="site-nav-links">
					<a href="/">Home</a>
					<a href="/packages">Packages</a>
					<a href="/privacy-policy">Privacy Policy</a>
					<% if (currentUser && (currentUser.is_admin || currentUser.role === 'admin')) { %>
						<a href="/admin/bookings">Admin</a>
					<% } %>
					<a href="/contact">Contact</a>
				</div>

				<button class="nav-overlay" type="button" aria-label="Close navigation menu"></button>

				<div class="nav-actions">
					<% if (currentUser) { %>
						<a class="button button-outline auth-image-button" href="/user" aria-label="User account" title="Your account">
							<img class="auth-image-icon" src="/assets/user-image.png" alt="User account" />
						</a>
					<% } else { %>
						<a class="button button-outline auth-image-button" href="/login" aria-label="Login" title="Login">
							<img class="auth-image-icon" src="/assets/user-image.png" alt="Login" />
						</a>
					<% } %>
				</div>
			</nav>
			<script>
			(() => {
				const toggle = document.querySelector('.nav-toggle');
				const overlay = document.querySelector('.nav-overlay');
				const navLinks = document.querySelector('.nav-links');
				if (!toggle || !overlay || !navLinks) return;

				const closeNav = () => {
					document.body.classList.remove('nav-open');
					toggle.setAttribute('aria-expanded', 'false');
				};

				const openNav = () => {
					document.body.classList.add('nav-open');
					toggle.setAttribute('aria-expanded', 'true');
				};

				toggle.addEventListener('click', () => {
					if (document.body.classList.contains('nav-open')) {
						closeNav();
					} else {
						openNav();
					}
				});

				overlay.addEventListener('click', closeNav);
				navLinks.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeNav));

				const closeOnPageTouch = (event) => {
					if (!document.body.classList.contains('nav-open')) return;
					if (toggle.contains(event.target)) return;
					if (navLinks.contains(event.target)) return;
					closeNav();
				};

				document.addEventListener('click', closeOnPageTouch);

				document.addEventListener('keydown', (event) => {
					if (event.key === 'Escape') {
						closeNav();
					}
				});

				window.addEventListener('resize', () => {
					if (window.innerWidth > 980) {
						closeNav();
					}
				});
			})();
			</script>
		</header>

		<main class="page-wrap">
