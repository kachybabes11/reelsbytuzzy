<%- include ("./partials/header.ejs") %>
<%- include('./partials/messages.ejs') %>

<section class="auth-layout auth-layout-centered">

  <article class="auth-card auth-card-oauth">
    <div class="auth-oauth-brand">
      <span class="auth-oauth-logo" aria-hidden="true">🎬</span>
      <h2 class="page-title">Create your account</h2>
      <p class="page-subtitle">Get started in seconds — no password needed.</p>
    </div>

    <a href="/auth/google" class="oauth-button oauth-button-hero">
      <img src="/assets/gmail_logo.webp" alt="" class="oauth-icon oauth-icon-lg" />
      <span>Continue with Google</span>
    </a>

    <p class="auth-oauth-note">Already have an account? <a href="/login" class="auth-link">Sign in here</a></p>
  </article>
</section>

<%- include('./partials/footer.ejs') %>