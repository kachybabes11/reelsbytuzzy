<%- include('./partials/header.ejs') %>
<%- include('./partials/messages.ejs') %>

<section class="auth-layout">
  <article class="auth-card">
    <h2 class="page-title">Reset Password</h2>

    <% if (!tokenValid) { %>
      <p class="page-subtitle">This reset link is invalid or expired. Request a new reset email to continue.</p>
      <div class="auth-footer">
        <p><a href="/forgot-password" class="auth-link">Request a new reset link</a></p>
      </div>
    <% } else { %>
      <p class="page-subtitle">Enter your new password below to complete your reset.</p>

      <form action="/reset-password" method="post" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="token" value="<%= token %>" />

        <div class="form-group">
          <label for="password">New Password</label>
          <input type="password" id="password" name="password" required minlength="6" placeholder="••••••••" />
        </div>

        <div class="form-group">
          <label for="confirm-password">Confirm New Password</label>
          <input
            type="password"
            id="confirm-password"
            name="confirm-password"
            required
            minlength="6"
            placeholder="••••••••"
          />
        </div>

        <button type="submit" class="button button-primary auth-button">Update Password</button>
      </form>
    <% } %>

    <div class="auth-footer">
      <p><a href="/login" class="auth-link">Back to sign in</a></p>
    </div>
  </article>
</section>

<%- include('./partials/footer.ejs') %>
