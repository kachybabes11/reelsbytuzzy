<%- include('./partials/header.ejs') %>
<%- include('./partials/messages.ejs') %>

<section class="section-shell hourly-hero">
	<div class="hourly-hero-copy">
		<span class="eyebrow">Hourly Booking</span>
		<h1 class="page-title"><%= pkg ? pkg.name : 'Hourly Booking' %></h1>
		<p class="page-subtitle">A single premium hourly booking option with event-type selection, tiered duration pricing, and add-on videos.</p>
		<div class="hourly-hero-actions">
			<a href="/bookings?package=<%= pkg ? encodeURIComponent(pkg.slug) : '' %>" class="button button-primary">Book Hourly</a>
			<a href="/packages" class="button button-outline">View Standard Packages</a>
		</div>
	</div>
	<div class="hourly-hero-panel">
		<div class="hourly-hero-stat">
			<span>Coverage tiers</span>
			<strong><%= pkg?.bookingConfig?.durationOptions?.length || 0 %></strong>
		</div>
		<div class="hourly-hero-stat">
			<span>Video add-ons</span>
			<strong>₦<%= Number(pkg?.bookingConfig?.videoPrice || 0).toLocaleString() %>/video</strong>
		</div>
		<div class="hourly-hero-stat">
			<span>Best for</span>
			<strong>Editorial event coverage</strong>
		</div>
	</div>
</section>

<section class="hourly-packages-grid section-shell">
	<article class="hourly-package-card hourly-package-card-featured">
		<div class="hourly-package-top">
			<span class="category"><%= pkg?.category || 'Coverage' %></span>
			<h2><%= pkg ? pkg.name : 'Hourly Booking' %></h2>
		</div>

		<div class="hourly-price-lockup">
			<span>Starting at</span>
			<strong>₦<%= Number(pkg?.price || 0).toLocaleString() %></strong>
		</div>

		<ul class="hourly-feature-list">
			<% (pkg?.bookingConfig?.eventTypes || []).forEach((feature) => { %>
				<li><%= feature %></li>
			<% }) %>
		</ul>

		<div class="hourly-feature-note">
			<p><strong>Duration tiers:</strong> <%= (pkg?.bookingConfig?.durationOptions || []).map((option) => option.label).join(' · ') %></p>
			<p><strong>Video pricing:</strong> ₦<%= Number(pkg?.bookingConfig?.videoPrice || 0).toLocaleString() %> per video</p>
		</div>

		<div class="hourly-package-actions">
			<a href="/bookings?package=<%= pkg ? encodeURIComponent(pkg.slug) : '' %>" class="button button-primary">Book Hourly</a>
		</div>
	</article>
</section>

<%- include('./partials/footer.ejs') %>
