<%- include('./partials/header.ejs') %>
<%- include('./partials/messages.ejs') %>

<section class="auth-layout">
  <article class="auth-card">
    <h2 class="page-title">Sign In</h2>
    <p class="page-subtitle">Access your dashboard and continue where you left off.</p>
    <form action="/login" method="post" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" required placeholder="you@example.com" />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required placeholder="••••••••" />
        </div>
        <button type="submit" class="button button-primary auth-button">Sign In</button>
    </form>

    <% if (googleEnabled) { %>
      <div class="oauth-section">
        <div class="divider">
          <span>Or continue with</span>
        </div>
        <a href="/auth/google" class="oauth-button">
          <img src="/assets/gmail_logo.webp" alt="Google" class="oauth-icon" />
          <span>Google</span>
        </a>
      </div>
    <% } %>

    <div class="auth-footer">
      <p>Don't have an account? <a href="/register" class="auth-link">Sign up here</a></p>
    </div>
  </article>
</section>

<%- include('./partials/footer.ejs') %>