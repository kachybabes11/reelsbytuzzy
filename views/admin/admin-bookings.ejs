<%- include('../partials/header.ejs') %>
<%- include('../partials/messages.ejs') %>

<section class="section-shell admin-dashboard-shell">
	<div class="admin-dashboard-head">
		<div>
			<span class="eyebrow">Administrator</span>
			<h1 class="page-title">Bookings Dashboard</h1>
			<p class="page-subtitle">Monitor confirmed sessions, active reservations, and upcoming production schedule in one place.</p>
		</div>
		<a class="button button-primary" href="#package-management">Manage packages</a>
	</div>

	<div class="admin-kpi-grid">
		<article class="admin-kpi-card">
			<span>Total Confirmed</span>
			<strong><%= Number(stats?.total_confirmed || 0).toLocaleString() %></strong>
		</article>
		<article class="admin-kpi-card">
			<span>Confirmed Today</span>
			<strong><%= Number(stats?.today_confirmed || 0).toLocaleString() %></strong>
		</article>
		<article class="admin-kpi-card">
			<span>Upcoming</span>
			<strong><%= Number(stats?.upcoming_confirmed || 0).toLocaleString() %></strong>
		</article>
		<article class="admin-kpi-card">
			<span>Paid Revenue</span>
			<strong>₦<%= Number(stats?.paid_revenue || 0).toLocaleString() %></strong>
		</article>
		<article class="admin-kpi-card">
			<span>Outstanding Balance</span>
			<strong>₦<%= Number(stats?.outstanding_balance || 0).toLocaleString() %></strong>
		</article>
	</div>

	<section class="admin-holds-panel">
		<h2>Hourly Booking Setup</h2>
		<p>The hourly booking flow is now fixed to a single package with tiered pricing, event type selection, and per-video pricing.</p>
		<p>Current maximum duration tier: <strong><%= maxHourlyBookingHours %> hours</strong></p>
		<p>Included event types: Birthday Parties, Lifestyle Content, Anniversaries, Memorials, BTS Shoots, Naming Ceremony / Baby Dedication, Personal Branding (Talking Head Videos).</p>
	</section>

	<section class="admin-holds-panel">
		<h2>Active Temporary Reservations</h2>
		<p>Slots are reserved while customers complete payment. Transit/prep buffer between sessions: <strong><%= bookingBufferMinutes %> minutes</strong>.</p>
		<% if (activeHolds && activeHolds.length) { %>
			<ul class="admin-holds-list">
				<% activeHolds.forEach((hold) => { %>
					<li>
						<div>
							<strong><%= hold.customer_name %></strong>
							<span><%= hold.package_name %> | <%= hold.booking_date ? new Date(hold.booking_date).toLocaleDateString('en-GB') : '' %> @ <%= hold.start_time ? String(hold.start_time).slice(0, 5) : '' %></span>
						</div>
						<small>Expires: <%= hold.expires_at ? new Date(hold.expires_at).toLocaleString() : '' %></small>
					</li>
				<% }) %>
			</ul>
		<% } else { %>
			<p>No active reservations right now.</p>
		<% } %>
	</section>

	<section class="admin-table-panel" id="package-management">
		<div class="admin-section-head">
			<div>
				<h2>Package Management</h2>
				<p>Create, edit, activate, or remove packages without leaving the dashboard.</p>
			</div>
		</div>
		<form class="admin-package-form admin-create-package-form" data-package-form data-mode="create">
			<h3>Create package</h3>
			<div class="admin-form-grid">
				<label>Name <input name="name" required></label>
				<label>Slug <input name="slug" required pattern="[a-z0-9-]+"></label>
				<label>Category <input name="category"></label>
				<label>Price (NGN) <input name="price" type="number" min="0"></label>
				<label>Duration (minutes) <input name="durationMinutes" type="number" min="0"></label>
				<label class="admin-form-wide">Video placeholder image URL <input name="thumbnail" type="text" placeholder="/assets/package-placeholder.jpg"></label>
				<label>Package type
					<select name="packageType"><option value="standard">Standard</option><option value="hourly">Hourly</option></select>
				</label>
				<label class="admin-form-wide">Description <textarea name="description" rows="2"></textarea></label>
				<label class="admin-form-wide">Booking configuration (JSON) <textarea name="bookingConfig" rows="3">{}</textarea></label>
			</div>
			<button class="button button-primary" type="submit">Create package</button>
			<p class="admin-form-status" data-status></p>
		</form>

		<div class="admin-package-list">
			<% adminPackages.forEach((pkg) => { %>
				<form class="admin-package-form admin-package-card" data-package-form data-mode="update" data-id="<%= pkg.id %>">
					<div class="admin-package-card-head">
						<h3><%= pkg.name %></h3>
						<span class="admin-package-state <%= pkg.isActive ? 'is-active' : '' %>"><%= pkg.isActive ? 'Active' : 'Inactive' %></span>
					</div>
					<div class="admin-form-grid">
						<label>Name <input name="name" value="<%= pkg.name || '' %>" required></label>
						<label>Slug <input name="slug" value="<%= pkg.slug || '' %>" required pattern="[a-z0-9-]+"></label>
						<label>Category <input name="category" value="<%= pkg.category || '' %>"></label>
						<label>Price (NGN) <input name="price" type="number" min="0" value="<%= pkg.price ?? '' %>"></label>
						<label>Duration (minutes) <input name="durationMinutes" type="number" min="0" value="<%= pkg.durationMinutes ?? '' %>"></label>
						<label class="admin-form-wide">Video placeholder image URL <input name="thumbnail" type="text" value="<%= pkg.thumbnail || '' %>" placeholder="/assets/package-placeholder.jpg"></label>
						<label>Package type
							<select name="packageType">
								<option value="standard" <%= pkg.packageType === 'standard' ? 'selected' : '' %>>Standard</option>
								<option value="hourly" <%= pkg.packageType === 'hourly' ? 'selected' : '' %>>Hourly</option>
							</select>
						</label>
						<label class="admin-form-wide">Description <textarea name="description" rows="2"><%= pkg.description || '' %></textarea></label>
						<label class="admin-form-wide">Booking configuration (JSON) <textarea name="bookingConfig" rows="3"><%= JSON.stringify(pkg.bookingConfig || {}, null, 2) %></textarea></label>
						<label class="admin-checkbox"><input name="isActive" type="checkbox" <%= pkg.isActive ? 'checked' : '' %>> Active</label>
					</div>
					<div class="admin-form-actions">
						<button class="button button-primary" type="submit">Save changes</button>
						<button class="button button-danger" type="button" data-delete-package>Delete package</button>
						<p class="admin-form-status" data-status></p>
					</div>
				</form>
			<% }) %>
		</div>
	</section>

	<section class="admin-table-panel">
		<h2>All Confirmed/Paid Booking Records</h2>
		<% if (adminRows && adminRows.length) { %>
			<div class="admin-booking-cards">
				<% adminRows.forEach((row) => { %>
					<a class="admin-booking-card" href="/admin/bookings/<%= row.id %>">
						<strong><%= row.booking_reference %></strong>
						<span><%= row.customer_name %> · <%= row.package_name %></span>
						<span><%= row.booking_date ? new Date(row.booking_date).toLocaleDateString('en-GB') : 'No date' %> · <%= row.payment_status || 'Payment pending' %></span>
					</a>
				<% }) %>
			</div>
			<div class="admin-booking-table-wrap">
				<table class="admin-booking-table">
					<thead>
						<tr>
							<th>Booking Ref</th>
							<th>Customer</th>
							<th>Phone</th>
							<th>Email</th>
							<th>Package</th>
							<th>Type</th>
							<th>Total</th>
							<th>Paid</th>
							<th>Remaining</th>
							<th>Date</th>
							<th>Time</th>
							<th>Selected Events</th>
							<th>Duration</th>
							<th>Location</th>
							<th>Payment</th>
							<th>Status</th>
							<th>Payment Ref</th>
						</tr>
					</thead>
					<tbody>
						<% adminRows.forEach((row) => { %>
							<tr>
								<td><%= row.booking_reference %></td>
								<td><%= row.customer_name %></td>
								<td><%= row.customer_phone %></td>
								<td><%= row.customer_email %></td>
								<td><%= row.package_name %></td>
								<td><%= row.package_type %></td>
								<td>₦<%= Number(row.package_price || 0).toLocaleString() %></td>
								<td>₦<%= Number(row.deposit_amount || 0).toLocaleString() %></td>
								<td>₦<%= Number(row.remaining_balance || 0).toLocaleString() %></td>
								<td><%= row.booking_date ? new Date(row.booking_date).toLocaleDateString('en-GB') : '' %></td>
								<td><%= row.start_time ? String(row.start_time).slice(0, 5) : '' %> - <%= row.end_time ? String(row.end_time).slice(0, 5) : '' %></td>
								<td>
									<% const selectedEvents = Array.isArray(row.selected_wedding_events) ? row.selected_wedding_events : []; %>
									<% const selectedEventDates = row.selected_event_dates && typeof row.selected_event_dates === 'object' ? row.selected_event_dates : {}; %>
									<% if (selectedEvents.length) { %>
										<ul class="admin-event-list">
											<% selectedEvents.forEach((eventItem) => { %>
												<li><%= eventItem.name %> (<%= selectedEventDates[eventItem.slug] ? new Date(selectedEventDates[eventItem.slug]).toLocaleDateString('en-GB') : 'No date' %>)</li>
											<% }) %>
										</ul>
									<% } else { %>
										<span>-</span>
									<% } %>
								</td>
								<td><%= row.duration_minutes %> mins</td>
								<td><%= row.location %></td>
								<td><%= row.payment_status %></td>
								<td><%= row.status %></td>
								<td><%= row.payment_reference %></td>
							</tr>
						<% }) %>
					</tbody>
				</table>
			</div>
		<% } else { %>
			<p>No bookings yet.</p>
		<% } %>
	</section>
</section>

<script>
(() => {
	const token = <%- JSON.stringify(csrfToken || '') %>;
	const payload = (form) => {
		const data = Object.fromEntries(new FormData(form).entries());
		data.isActive = form.querySelector('[name="isActive"]')?.checked ?? true;
		data.bookingConfig = data.bookingConfig || "{}";
		data.features = "[]";
		data.extraFeatures = "[]";
		return data;
	};
	document.querySelectorAll('[data-package-form]').forEach((form) => {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const status = form.querySelector('[data-status]');
			try {
				const id = form.dataset.id;
				const response = await fetch(id ? `/api/packages/${id}` : '/api/packages', {
					method: id ? 'PATCH' : 'POST',
					headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': token },
					body: JSON.stringify(payload(form)),
				});
				const result = await response.json();
				if (!response.ok) throw new Error(result.message || 'Unable to save package.');
				status.textContent = result.message;
				status.className = 'admin-form-status is-success';
				if (!id) window.location.reload();
			} catch (error) {
				status.textContent = error.message;
				status.className = 'admin-form-status is-error';
			}
		});
	});
	document.querySelectorAll('[data-delete-package]').forEach((button) => {
		button.addEventListener('click', async () => {
			const form = button.closest('[data-package-form]');
			if (!window.confirm('Delete this package?')) return;
			const status = form.querySelector('[data-status]');
			try {
				const response = await fetch(`/api/packages/${form.dataset.id}`, {
					method: 'DELETE',
					headers: { 'X-CSRF-Token': token },
				});
				const result = await response.json();
				if (!response.ok) throw new Error(result.message || 'Unable to delete package.');
				form.remove();
			} catch (error) {
				status.textContent = error.message;
				status.className = 'admin-form-status is-error';
			}
		});
	});
})();
</script>

<%- include('../partials/footer.ejs') %>
