<%- include('./partials/header.ejs') %>
<%- include('./partials/messages.ejs') %>

<section class="section-shell booking-confirmation <%= success ? 'success' : 'error' %>">
	<div class="confirmation-icon-wrap">
		<div class="confirmation-icon <%= success ? 'is-success' : 'is-error' %>">
			<% if (success) { %>
				<span class="checkmark"></span>
			<% } else { %>
				<span class="crossmark"></span>
			<% } %>
		</div>
	</div>

	<h1 class="page-title"><%= success ? 'Booking Confirmed' : 'Booking Needs Attention' %></h1>
	<p class="page-subtitle"><%= message %></p>

	<div class="confirmation-meta">
		<p><strong>Booking Reference:</strong> <%= bookingReference || 'Pending Manual Review' %></p>
		<p><strong>Package:</strong> <%= packageName || 'Not Available' %></p>
		<p><strong>Payment:</strong> <%= paymentStatus || 'Paid' %></p>
		<p><strong>Payment Terms:</strong> Paid in full at checkout.</p>
		<p><strong>Coverage:</strong> Your package selections have been saved.</p>
		<p><strong>Event Date:</strong> <%= bookingDate ? new Date(bookingDate).toLocaleDateString('en-GB') : 'Not Available' %></p>
		<% if (selectedWeddingEvents && selectedWeddingEvents.length) { %>
			<p><strong>Selected Wedding Events:</strong></p>
			<ul class="confirmation-event-list">
				<% selectedWeddingEvents.forEach((eventItem) => { %>
					<li>
						<span><%= eventItem.name %></span>
						<strong><%= selectedEventDates?.[eventItem.slug] ? new Date(selectedEventDates[eventItem.slug]).toLocaleDateString('en-GB') : 'Date unavailable' %></strong>
					</li>
				<% }) %>
			</ul>
		<% } %>
		<p><strong>Contact:</strong> +234 708 806 9114 | reelsbytuzzy@gmail.com</p>
	</div>

	<div class="confirmation-actions">
		<a href="/" class="button button-primary">Return Home</a>
		<button class="button button-outline" type="button" disabled>Download Receipt</button>
	</div>
</section>

<%- include('./partials/footer.ejs') %>
