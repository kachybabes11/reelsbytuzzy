<%- include('./partials/header.ejs') %>
<%- include('./partials/messages.ejs') %>

<section class="section-shell privacy-policy-shell">
	<span class="eyebrow">Privacy Policy</span>
	<h1 class="page-title">How we handle your information</h1>
	<p class="page-subtitle">We use your details only to manage bookings, confirm payments, and send service updates. We do not sell your personal information.</p>

	<div class="privacy-policy-grid">
		<div class="privacy-policy-card">
			<h2>Information we collect</h2>
			<p>We collect your name, email address, phone number, event details, and payment confirmation so we can process and deliver your booking.</p>
		</div>
		<div class="privacy-policy-card">
			<h2>How we use it</h2>
			<p>Your details are used to reserve availability, complete payments, send receipts, and contact you about your booking.</p>
		</div>
		<div class="privacy-policy-card">
			<h2>Data sharing</h2>
			<p>We only share information with trusted payment and communication providers required to run the booking service.</p>
		</div>
		<div class="privacy-policy-card">
			<h2>Contact</h2>
			<p>If you have questions about this policy, email reelsbytuzzy@gmail.com or call +234 708 806 9114.</p>
		</div>
	</div>
</section>

